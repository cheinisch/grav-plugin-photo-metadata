{% extends 'partials/base.html.twig' %}

{% block content %}
<h1>Foto-Metadaten</h1>

<form method="get" action="{{ base_url_relative }}/{{ admin.route }}">
    <p>
        <label for="pm-page">Seite (Route), z. B. <code>/fotos/album-1</code></label><br>
        <input id="pm-page" type="text" name="page" value="{{ photo_metadata_page }}">
        <button type="submit" class="button">Laden</button>
    </p>
</form>

{% if photo_metadata_page %}
<form method="post" action="{{ base_url_relative }}/{{ admin.route }}">
    <input type="hidden" name="task" value="savePhotoMetadata">
    <input type="hidden" name="admin-nonce" value="{{ photo_metadata_nonce }}">
    <input type="hidden" name="page" value="{{ photo_metadata_page }}">

    {% if photo_metadata_items is empty %}
        <p>Keine Bilder auf dieser Seite gefunden.</p>
    {% endif %}

    {% for item in photo_metadata_items %}
    <fieldset style="margin-bottom: 1.5rem;">
        <legend>{{ item.name }}</legend>
        <img src="{{ item.url }}" alt="" style="max-width: 160px; height: auto;">

        <p><label>Titel<br>
            <input type="text" name="photo_metadata[{{ item.name }}][title]" value="{{ item.values.title ?? '' }}">
        </label></p>

        <p><label>Beschreibung<br>
            <textarea name="photo_metadata[{{ item.name }}][description]">{{ item.values.description ?? '' }}</textarea>
        </label></p>

        <p><label>Alt-Text<br>
            <input type="text" name="photo_metadata[{{ item.name }}][alt]" value="{{ item.values.alt ?? '' }}">
        </label></p>

        <p><label>Schlagwörter (kommagetrennt)<br>
            <input type="text" name="photo_metadata[{{ item.name }}][keywords]" value="{{ item.values.keywords ? item.values.keywords|join(', ') : '' }}">
        </label></p>

        <p><label>Autor<br>
            <input type="text" name="photo_metadata[{{ item.name }}][author]" value="{{ item.values.author ?? '' }}">
        </label></p>
    </fieldset>
    {% endfor %}

    {% if photo_metadata_items is not empty %}
        <button type="submit" class="button button-primary">Speichern</button>
    {% endif %}
</form>
{% endif %}
{% endblock %}
